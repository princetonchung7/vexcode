#include "main.h"

pros::Controller controller(pros::E_CONTROLLER_MASTER);

// ----- DRIVETRAIN ----- //
pros::MotorGroup leftMotors({-12, -13, -14}, pros::MotorGearset::blue);
pros::MotorGroup rightMotors({1, 2, 3}, pros::MotorGearset::blue, true); // reversed

pros::Imu imu(10);

// ----- SUBSYSTEMS ----- //
pros::Motor intakeMotor(20);
pros::Motor outTakeMotor(9);
pros::adi::DigitalOut switchPiston('B');
pros::adi::DigitalOut matchLoader('A');
pros::adi::DigitalOut descore('E');

// ----- SETTINGS ----- //
const int DEADZONE = 10;
const int MAX_SPEED = 127;
const int SLEW_STEP = 6;    // smooth acceleration
const double HEADING_KP = 0.5;
const double HEADING_KD = 0.1;

// optional multiplier if one side is slightly stronger
const double DRIFT_COMP = 0.96;

// ----- GLOBALS ----- //
int prevLeftPower = 0;
int prevRightPower = 0;
double targetHeading = 0;
double lastHeadingError = 0;
bool headingAssistActive = false;

// ----- HELPERS ----- //
int applyDeadzone(int val) {
    return (abs(val) > DEADZONE) ? val : 0;
}

int slew(int target, int current) {
    if (target > current) {
        current += SLEW_STEP;
        if (current > target) current = target;
    } else if (target < current) {
        current -= SLEW_STEP;
        if (current < target) current = target;
    }
    return current;
}

// ----- OPCONTROL ----- //
void opcontrol() {

    // initialize heading
    targetHeading = imu.get_heading();

    while (true) {

        // --- DRIVER INPUT ---
        int forward = applyDeadzone(controller.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_Y));
        int turn    = applyDeadzone(controller.get_analog(pros::E_CONTROLLER_ANALOG_RIGHT_X));

        double headingError = 0;
        double turnCorrection = 0;

        // --- HEADING ASSIST ---
        if (abs(turn) < DEADZONE && abs(forward) > DEADZONE) {
            headingAssistActive = true;

            headingError = targetHeading - imu.get_heading();
            while (headingError > 180) headingError -= 360;
            while (headingError < -180) headingError += 360;

            double derivative = headingError - lastHeadingError;
            turnCorrection = headingError * HEADING_KP + derivative * HEADING_KD;
            lastHeadingError = headingError;

        } else if (abs(turn) > DEADZONE) {
            headingAssistActive = false;
            targetHeading = imu.get_heading(); // reset target when manually turning
        }

        // --- MOTOR OUTPUT ---
        int leftPower  = forward + turnCorrection + turn;
        int rightPower = forward - turnCorrection - turn;

        // apply drift compensation
        rightPower = rightPower * DRIFT_COMP;

        // slew rate
        prevLeftPower  = slew(leftPower, prevLeftPower);
        prevRightPower = slew(rightPower, prevRightPower);

        // set motors
        leftMotors.move(prevLeftPower);
        rightMotors.move(prevRightPower);

        // --- SUBSYSTEMS ---
        intakeMotor.move(controller.get_digital(pros::E_CONTROLLER_DIGITAL_R1) ? -127 :
                         controller.get_digital(pros::E_CONTROLLER_DIGITAL_R2) ? 127 : 0);

        outTakeMotor.move(controller.get_digital(pros::E_CONTROLLER_DIGITAL_L1) ? 127 :
                          controller.get_digital(pros::E_CONTROLLER_DIGITAL_L2) ? -127 : 0);

        switchPiston.set_value(controller.get_digital(pros::E_CONTROLLER_DIGITAL_X));
        matchLoader.set_value(controller.get_digital(pros::E_CONTROLLER_DIGITAL_Y));
        descore.set_value(controller.get_digital(pros::E_CONTROLLER_DIGITAL_A));

        pros::delay(20);
    }
}
